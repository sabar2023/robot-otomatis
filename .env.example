EXCHANGE_ID=binance
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT
# Jarak SL / TP dalam persen dari entry (rentas saran: SL 2-3, TP 5-10)
SL_PCT=2.5
TP_PCT=7.5
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=paste-token-bot-di-sini
# ID tujuan chat/grup/channel (angka, atau @nama_channel untuk channel publik)
TELEGRAM_CHAT_ID=paste-chat-id-di-sini

# ===== Sub-sistem VST V5.0 (platform multi-user, BingX VST demo, folder vst/) =====
# 0 = dry-run (default, tidak ada order dikirim), 1 = kirim order bracket ke BingX VST
VST_LIVE=0
# Timeframe scan (default 1h sesuai V5.0; opsi: 5m, 15m, 1h, 4h)
VST_TIMEFRAME=1h
# API key fallback untuk akun owner (bila user belum ada di Supabase)
# API key dibuat di BingX menu "Demo Trading" (VST), bukan API key trading riil
BINGX_API_KEY=paste-api-key-bingx-vst-di-sini
BINGX_SECRET_KEY=paste-secret-key-bingx-vst-di-sini
# Opsional: override margin maksimal per order (persen saldo), jumlah koin watchlist default
VST_MARGIN_PCT=10
VST_WATCHLIST_SIZE=5
VST_FRESH_MAX_AGE_MINUTES=90

# ===== Supabase (log scan/eksekusi + toggle Auto/Manual + user SaaS) =====
SUPABASE_URL=https://jklbczruvbxscpwxxfud.supabase.co
# anon public key (Supabase Dashboard -> Settings -> API)
SUPABASE_KEY=paste-anon-key-supabase-di-sini
# service role key, dipakai engine baca user_settings/trade_history lintas user
SUPABASE_SERVICE_KEY=paste-service-key-supabase-di-sini
# Kunci enkripsi (Fernet) untuk API key user di user_settings: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENC_KEY=paste-fernet-key-44-karakter-base64-di-sini
