EXCHANGE_ID=binance
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=paste-token-bot-di-sini
# ID tujuan chat/grup/channel (angka, atau @nama_channel untuk channel publik)
TELEGRAM_CHAT_ID=paste-chat-id-di-sini

# ===== Sub-sistem VST (robot eksekusi demo BingX, folder vst/) =====
# 0 = dry-run (default, tidak ada order dikirim), 1 = kirim bracket order ke BingX VST
VST_LIVE=0
# API key dibuat di BingX menu "Demo Trading" (VST), bukan API key trading riil
BINGX_API_KEY=paste-api-key-bingx-vst-di-sini
BINGX_SECRET_KEY=paste-secret-key-bingx-vst-di-sini
# Opsional: ukuran posisi (USDT), leverage, koin
VST_POSITION_SIZE_USDT=100
VST_LEVERAGE=10
VST_SYMBOL=BTC/USDT:USDT
